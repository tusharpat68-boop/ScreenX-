    <string name="sec_other">About ScreenX</string>
    <string name="set_version">App version</string>
    <string name="set_privacy_policy">Privacy policy</string>
    <string name="set_about">About</string>
    <string name="set_feedback">Send feedback</string>
    <string name="feedback_subject">ScreenX AI feedback</string>
    <string name="feedback_chooser">Send feedback via</string>
    <string name="privacy_policy_text">ScreenX AI does not collect, upload or share your data. The app has no internet permission, so your recordings, screenshots, audio and camera images stay on your device unless you choose to share them.\n\nPermissions are used only for what you turn on: screen capture (Android asks every time) for recording, the microphone for audio, the camera for the face bubble, display over other apps for floating tools, and notifications for recording status and reminders.\n\nRecordings are saved in your Movies folder, screenshots in Pictures and extracted audio in Music, inside the folder you choose in Settings. You can delete them at any time from the Recordings and Screenshots tabs.</string>
    <string name="about_text">ScreenX AI · Ultimate Edition\nVersion %1$s\n\nA screen recorder that works entirely on your device: recording with audio, a face camera, drawing tools, a library, a video editor and screenshots.</string>

